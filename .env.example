# Copia este fichero como .env.local y rellena los valores reales.
# En producción, estas variables se configuran en Vercel (Project Settings > Environment Variables).

VITE_DATA_SOURCE=baserow
VITE_SHOW_DIAGNOSTICS=false

VITE_BASEROW_API_URL=https://api.baserow.io

# Token de Baserow (privado). En producción usar BASEROW_TOKEN en Vercel.
VITE_BASEROW_TOKEN=

# IDs de las tablas de Baserow de Esmorzarets (no las de la app de danzas).
VITE_BASEROW_EVENTS_TABLE_ID=1165050
VITE_BASEROW_MEMBERS_TABLE_ID=1165048
VITE_BASEROW_PLACES_TABLE_ID=1165049
VITE_BASEROW_ATTENDANCE_TABLE_ID=1165051

# Secreto para firmar las cookies de sesión (solo servidor, configurar en Vercel).
SESSION_SECRET=
